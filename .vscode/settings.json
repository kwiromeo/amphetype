{
    "python.languageServer": "None",
    "python.analysis.typeCheckingMode": "off",
    "cSpell.allowCompoundWords": true,
    "cSpell.words": [
        "Amph",
        "amphetype",
        "colemak",
        "djlint",
        "GTRONICK",
        "Hestvik",
        "ints",
        "itertools",
        "Neue",
        "ngrams",
        "noqa",
        "pyinstaller",
        "pyproject",
        "pyqt",
        "Segoe",
        "translitcodec",
        "Typer",
        "visc"
    ],
    "cSpell.ignorePaths": [
        "package-lock.json",
        "node_modules",
        "vscode-extension",
        ".git/{info,lfs,logs,refs,objects}/**",
        ".git/{index,*refs,*HEAD}",
        ".vscode",
        ".vscode-insiders",
        "_scripts/*",
        "uv.lock"
    ],
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 500,
    "editor.rulers": [
        100
    ],
    "editor.tabSize": 2
}
