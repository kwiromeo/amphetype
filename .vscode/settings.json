{
    "python.analysis.typeCheckingMode": "standard",
    "cSpell.allowCompoundWords": true,
    "cSpell.words": [
        "Amph",
        "amphetype"
    ],
    "cSpell.ignorePaths": [
        "package-lock.json",
        "node_modules",
        "vscode-extension",
        ".git/{info,lfs,logs,refs,objects}/**",
        ".git/{index,*refs,*HEAD}",
        ".vscode",
        ".vscode-insiders",
        "_scripts/*"
    ],
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 500,
    "editor.rulers": [100],
}
